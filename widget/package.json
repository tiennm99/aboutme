{
  "name": "@tiennm99/aboutme",
  "version": "1.8.0",
  "description": "A draggable floating 'about me' bubble for any website: one script tag shows your blog, GitHub, CV and socials. No framework, no cookies, light and dark themes.",
  "type": "module",
  "license": "MIT",
  "author": "tiennm99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiennm99/aboutme.git",
    "directory": "widget"
  },
  "homepage": "https://tiennm99.github.io/aboutme/",
  "keywords": [
    "about-me",
    "widget",
    "floating-button",
    "floating-bubble",
    "chat-bubble",
    "profile",
    "links",
    "link-in-bio",
    "personal-website",
    "portfolio",
    "social-links",
    "vanilla-js",
    "no-cookies",
    "dark-mode"
  ],
  "main": "dist/aboutme.js",
  "jsdelivr": "dist/aboutme.js",
  "unpkg": "dist/aboutme.js",
  "files": [
    "dist",
    "profile.schema.json"
  ],
  "exports": {
    ".": "./dist/aboutme.js",
    "./profile.schema.json": "./profile.schema.json"
  },
  "scripts": {
    "build": "node build.js",
    "size": "node scripts/check-size.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "esbuild": "^0.28.0",
    "vitest": "^5.0.0"
  }
}
